 using namespace Tissu;
 
+static bool pointInsideTetrahedron(const Eigen::Vector3d& point) {
+    const Eigen::Vector3d v0(0.0, 0.0, 0.0);
+    const Eigen::Vector3d v1(2.0, 0.0, 0.0);
+    const Eigen::Vector3d v2(1.0, 0.0, 2.0);
+    const Eigen::Vector3d v3(1.0, 2.0, 1.0);
+
+    Eigen::Matrix3d basis;
+    basis.col(0) = v1 - v0;
+    basis.col(1) = v2 - v0;
+    basis.col(2) = v3 - v0;
+    const Eigen::Vector3d barycentric =
+        basis.fullPivLu().solve(point - v0);
+    const double w0 = 1.0 - barycentric.sum();
+
+    return w0 >= -1e-9 && barycentric.x() >= -1e-9 &&
+           barycentric.y() >= -1e-9 && barycentric.z() >= -1e-9;
+}
