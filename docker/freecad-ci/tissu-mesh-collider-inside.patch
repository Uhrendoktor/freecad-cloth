 using namespace Tissu;
 
+static double maxOutwardPlaneDistance(const Eigen::Vector3d& point) {
+    static const Eigen::Vector3d vertices[] = {
+        {0.0, 0.0, 0.0},
+        {2.0, 0.0, 0.0},
+        {1.0, 0.0, 2.0},
+        {1.0, 2.0, 1.0},
+    };
+    static const int faces[][4] = {
+        {0, 2, 1, 3},
+        {0, 1, 3, 2},
+        {1, 2, 3, 0},
+        {0, 3, 2, 1},
+    };
+
+    double maximum = -std::numeric_limits<double>::infinity();
+    for (const auto& face : faces) {
+        const Eigen::Vector3d& a = vertices[face[0]];
+        const Eigen::Vector3d& b = vertices[face[1]];
+        const Eigen::Vector3d& c = vertices[face[2]];
+        Eigen::Vector3d normal = (b - a).cross(c - a);
+        if ((vertices[face[3]] - a).dot(normal) > 0.0)
+            normal = -normal;
+        normal.normalize();
+        maximum = std::max(maximum, (point - a).dot(normal));
+    }
+    return maximum;
+}
